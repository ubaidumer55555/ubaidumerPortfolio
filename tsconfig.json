{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment Settings */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["react", "react-dom"],

    /* Other Outputs */
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    /* Stricter Typechecking Options */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* JSX / React */
    "jsx": "react-jsx",

    /* Module Handling */
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true

    /* ⚠️ Removed:
       - "verbatimModuleSyntax": true (not needed for React frontend apps)
       - "nodenext" (use ESNext instead)
       - "declaration": true (only needed for publishing libs)
       - "noUncheckedSideEffectImports" (still experimental, can break builds)
    */
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
